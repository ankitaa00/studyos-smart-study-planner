# StudyOS Environment Variables
# Copy this file to .env and fill in your values

# Anthropic API Key (required for AI features: OCR parsing, difficulty rating, performance prediction)
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Custom DB path (default: ./data/studyos.db)
# DATABASE_PATH=./data/studyos.db
